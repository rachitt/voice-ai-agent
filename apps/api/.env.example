# =============================================================================
# voice-2.0 — backend environment template
#
# Copy to `.env` and fill in real values. All keys are prefixed `VOICE_`
# (pydantic-settings env_prefix). Empty defaults are safe to leave blank
# in local dev; the corresponding feature degrades gracefully (e.g. Telnyx
# routes return 503, recordings skip upload).
# =============================================================================

# ---- Core ------------------------------------------------------------------
VOICE_ENV=dev
VOICE_LOG_LEVEL=INFO

# Public URLs Telnyx + webhooks reach. Override in prod.
VOICE_PUBLIC_BASE_URL=http://localhost:8000
VOICE_PUBLIC_WS_BASE_URL=ws://localhost:8000
VOICE_WEB_APP_BASE_URL=http://localhost:5173

# Rotate before going live.
VOICE_WEBHOOK_HMAC_SECRET=dev-hmac-secret-rotate-in-prod
VOICE_API_KEY_PEPPER=dev-pepper-rotate-in-prod
# Dedicated signing key for session JWTs. Leave empty to fall back to
# VOICE_WEBHOOK_HMAC_SECRET (legacy behaviour). Set this in prod so the
# two secrets rotate independently.
VOICE_SESSION_SECRET=
VOICE_SESSION_COOKIE_NAME=voice_session
VOICE_SESSION_TTL_SECONDS=1209600

# Comma-separated; pydantic parses as list.
VOICE_CORS_ORIGINS=["http://localhost:5173"]

# ---- Datastores ------------------------------------------------------------
VOICE_DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5432/voice
VOICE_REDIS_URL=redis://localhost:6379/0

# ---- Object storage (MinIO / S3) -------------------------------------------
# Flip to true to enable call-recording uploads + async KB ingest.
VOICE_ENABLE_OBJECT_STORE=false
VOICE_S3_ENDPOINT=http://localhost:9000
VOICE_S3_ACCESS_KEY=voice
VOICE_S3_SECRET_KEY=voicevoice
VOICE_S3_REGION=us-east-1
VOICE_S3_BUCKET_RECORDINGS=voice-recordings
VOICE_S3_BUCKET_KB=voice-kb

# ---- Background workers ----------------------------------------------------
VOICE_ENABLE_ASYNC_KB_INGEST=false
VOICE_ENABLE_WEBHOOK_WORKER=false
VOICE_ENABLE_POST_CALL_ANALYSIS=false
VOICE_ANALYSIS_MODEL=gemini/gemini-3.1-flash-lite

# ---- LLM (Gemini via litellm) ----------------------------------------------
# Required for live agent turns + post-call analysis.
VOICE_GEMINI_API_KEY=

# ---- STT (Deepgram Nova-3) -------------------------------------------------
# Required for voice mode; web text-mode works without it.
VOICE_DEEPGRAM_API_KEY=

# ---- TTS (ElevenLabs Flash v2.5) -------------------------------------------
# Required for agent voice output.
VOICE_ELEVENLABS_API_KEY=

# ---- Telephony (Telnyx) ----------------------------------------------------
# Required for PSTN inbound/outbound. Without these, /v1/calls/phone returns 503.
VOICE_TELNYX_API_KEY=
VOICE_TELNYX_CONNECTION_ID=
# Ed25519 public key for webhook signature verification. Empty disables verify.
VOICE_TELNYX_WEBHOOK_PUBLIC_KEY=

# ---- Google OAuth (dashboard login) ----------------------------------------
VOICE_GOOGLE_OAUTH_CLIENT_ID=
VOICE_GOOGLE_OAUTH_CLIENT_SECRET=
VOICE_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/callback/google

# ---- Google Calendar (book_meeting builtin) --------------------------------
# Paste the entire service-account JSON blob on one line. Leave empty to
# disable; calls to book_meeting return {"error": "calendar_unconfigured"}.
VOICE_GOOGLE_SERVICE_ACCOUNT_JSON=
VOICE_GOOGLE_CALENDAR_ID=primary
VOICE_GOOGLE_CALENDAR_DEFAULT_DURATION_MIN=30

